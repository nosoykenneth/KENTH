# Forzar LF en archivos que se ejecutan dentro de contenedores Linux,
# para que un checkout en Windows no introduzca CRLF y rompa los scripts.
*.sh           text eol=lf
*.Dockerfile   text eol=lf
Dockerfile     text eol=lf
docker-compose*.yml text eol=lf
*.conf         text eol=lf
*.ini          text eol=lf
