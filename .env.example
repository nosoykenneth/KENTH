# ============================================================================
#  Plantilla segura para desarrollo/servidor.
#  Copiar a `.env` y reemplazar todos los CAMBIAR_* localmente.
# ============================================================================

PUBLIC_HOST=CAMBIAR_HOST_PUBLICO
PUBLIC_SCHEME=http

OLLAMA_BASE_URL=http://host.docker.internal:11434
KENTH_TEXT_MODEL=llama3.2:3b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
KENTH_EMBED_MODEL=nomic-embed-text
CHROMA_DIR=/app/bd_vectorial

MARIADB_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodleuser
MOODLE_DB_PASSWORD=CAMBIAR_PASSWORD_MOODLE_DB
MOODLE_DB_PREFIX=mdl_

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
MOODLE_ADMIN_EMAIL=CAMBIAR_EMAIL
MOODLE_SITE_NAME=TIC KENTH
MOODLE_BASE_URL=http://moodle:8080
MOODLE_WS_BASE=http://moodle:8080/webservice/rest/server.php
MOODLE_WS_TOKEN=CAMBIAR_TOKEN_MOODLE

MOODLE_DB_HOST=mariadb
MOODLE_DB_PORT=3306
KENTH_COURSE_ID_SECRET=CAMBIAR_SECRET_OPENSSL
TESISAI_ALLOW_SQLITE_FALLBACK=0

MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=mariadb
MOODLE_DBPORT=3306
MOODLE_DBNAME=moodle
MOODLE_DBUSER=moodleuser
MOODLE_DBPASS=CAMBIAR_PASSWORD_MOODLE_DB

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_PASSWORD_GRAFANA
GRAFANA_ADMIN_PASS=CAMBIAR_PASSWORD_GRAFANA