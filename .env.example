# --- Acceso público ---
# Reemplazar cuando el tutor confirme dominio o IP del servidor
PUBLIC_HOST=localhost

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://ollama:11434
KENTH_TEXT_MODEL=llama3.2:3b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
KENTH_EMBED_MODEL=nomic-embed-text

# --- Vector store ---
CHROMA_DIR=/app/bd_vectorial

# --- Moodle: acceso directo a BD (SOLO validación de token) ---
MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=mariadb
MOODLE_DBPORT=3306
MOODLE_DBNAME=moodle
MOODLE_DBUSER=moodle
MOODLE_DBPASS=changeme_moodle_db
MOODLE_ROOT_PASS=changeme_root_db

# --- Moodle: Web Services (sincronización Python ↔ LMS) ---
MOODLE_WS_BASE=http://moodle:8080/webservice/rest/server.php
MOODLE_WS_TOKEN=replace_with_token_emitted_in_moodle_admin

# --- Moodle: configuración propia del contenedor ---
MOODLE_USERNAME=admin
MOODLE_PASSWORD=changeme_moodle_admin
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=TIC KENTH

# --- FastAPI ---
KENTH_COURSE_ID_SECRET=changeme_signing_secret
TESISAI_ALLOW_SQLITE_FALLBACK=0

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=changeme_grafana
