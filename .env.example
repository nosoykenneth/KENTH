# --- Acceso publico ---
PUBLIC_HOST=CAMBIAR_HOST_PUBLICO

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://ollama:11434
KENTH_TEXT_MODEL=llama3.2:3b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
KENTH_EMBED_MODEL=nomic-embed-text

# --- Vector store ---
CHROMA_DIR=/app/bd_vectorial

# --- Moodle: acceso directo a BD (SOLO validacion de token) ---
MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=mariadb
MOODLE_DBPORT=3306
MOODLE_DBNAME=moodle
MOODLE_DBUSER=CAMBIAR_USUARIO_MYSQL
MOODLE_DBPASS=CAMBIAR_PASSWORD_MYSQL
MOODLE_ROOT_PASS=CAMBIAR_PASSWORD_ROOT_MYSQL

# --- Moodle: Web Services (sincronizacion Python <-> LMS) ---
MOODLE_WS_BASE=http://moodle:8080/webservice/rest/server.php
MOODLE_WS_TOKEN=CAMBIAR_TOKEN_MOODLE

# --- Moodle: configuracion propia del contenedor ---
MOODLE_USERNAME=admin
MOODLE_PASSWORD=CAMBIAR_PASSWORD_ADMIN_MOODLE
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=TIC KENTH

# --- FastAPI ---
KENTH_COURSE_ID_SECRET=CAMBIAR_SECRET_GENERADO_CON_OPENSSL
TESISAI_ALLOW_SQLITE_FALLBACK=0

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=CAMBIAR_PASSWORD_GRAFANA
