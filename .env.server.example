# ============================================================================
#  .env del SERVIDOR (despliegue hibrido). Copiar a `.env` y rellenar los CAMBIAR_*.
#  NO comitear el .env real: lleva secretos.
#    cp .env.server.example .env   &&   nano .env
#  Lo usa: docker compose -f docker-compose.server.yml --env-file .env up -d --build
# ============================================================================

# --- Acceso publico (IP o dominio del servidor) ---
PUBLIC_HOST=CAMBIAR_IP_O_DOMINIO

# --- Ollama NATIVO en el host (la GPU) ---
# host.docker.internal resuelve al host por la entrada extra_hosts del compose.
# Ollama DEBE escuchar en 0.0.0.0:11434 para aceptar la red del contenedor
# (lo configura scripts/setup-server.sh con un override de systemd).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Modelos. Con RTX 5070 Ti (16GB) el texto sube de 3b a 8b.
KENTH_TEXT_MODEL=llama3.1:8b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
# CRITICO: si COPIASTE bd_vectorial desde la laptop, el embed DEBE seguir siendo
# el mismo con que se construyo el indice, o queda invalido (mismatch de espacio).
# Solo cambialo si vas a REINDEXAR desde cero en el server.
KENTH_EMBED_MODEL=nomic-embed-text

# --- Vector store (ruta dentro del contenedor; se siembra por bind-mount) ---
CHROMA_DIR=/app/bd_vectorial

# --- Moodle NATIVO: MariaDB (solo validacion de token + tablas mdl_local_tesisai_*) ---
MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=host.docker.internal
MOODLE_DBPORT=3306
MOODLE_DBNAME=moodle
MOODLE_DBUSER=tic_kenth
MOODLE_DBPASS=CAMBIAR_PASSWORD_MYSQL
MOODLE_DB_PREFIX=mdl_

# --- Moodle Web Services (Apache nativo en :8081, detras del gateway) ---
MOODLE_WS_BASE=http://host.docker.internal:8081/webservice/rest/server.php
MOODLE_WS_TOKEN=CAMBIAR_TOKEN_MOODLE

# --- FastAPI ---
# Secreto de firma del course_id (HMAC). Genera uno: openssl rand -hex 32
KENTH_COURSE_ID_SECRET=CAMBIAR_SECRET_GENERADO_CON_OPENSSL
# 0 = exige Moodle (produccion). 1 = permite fallback SQLite (solo dev aislado).
TESISAI_ALLOW_SQLITE_FALLBACK=0

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=CAMBIAR_PASSWORD_GRAFANA

