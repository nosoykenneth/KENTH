KENTH_TEXT_MODEL=llama3.2:3b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
KENTH_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_DIR=./bd_vectorial

# ==========================================
# Asistente "Preparar tutor con IA" (autoría asistida) — selección por tarea.
# Solo lo consume services/ai_prepare/*. NO cambia el chat/embeddings en vivo.
# ==========================================
AI_PREP_MODEL=qwen2.5:14b-instruct
AI_PREP_REVIEW_MODEL=deepseek-r1:32b
AI_PREP_LONG_CONTEXT_MODEL=command-r:latest
AI_VISION_MODEL=qwen3-vl:4b-instruct
AI_CHAT_MODEL=llama3.1:8b
AI_EMBEDDING_MODEL=nomic-embed-text
# deepseek-r1:70b NO es default. Para usarlo en revisión quality=max, ponerlo aquí:
# AI_PREP_REVIEW_MODEL=deepseek-r1:70b
AI_PREP_TIMEOUT=300
AI_PREP_NUM_CTX=16384
AI_PREP_MAX_RETRIES=1
AI_PREP_LONG_CONTEXT_THRESHOLD=18000
AI_PREP_TRANSCRIPT_CHAR_LIMIT=60000

# ==========================================
# Transcripción (faster-whisper). En el server con GPU 5070 Ti subir a cuda/float16
# y large-v3 mejora mucho los términos técnicos ES (headroom, sidechain, LUFS...).
# ==========================================
KENTH_WHISPER_MODEL=small
KENTH_WHISPER_DEVICE=cpu
KENTH_WHISPER_COMPUTE=int8
# Recomendado en el server:
# KENTH_WHISPER_MODEL=large-v3
# KENTH_WHISPER_DEVICE=cuda
# KENTH_WHISPER_COMPUTE=float16

# Persistencia operativa Moodle-first.
# Por defecto el backend puede leer el config.php de Moodle si existe.
MOODLE_CONFIG_PATH=CAMBIAR_RUTA_CONFIG_MOODLE
MOODLE_DBTYPE=mariadb
MOODLE_DBHOST=CAMBIAR_HOST_MYSQL
MOODLE_DBPORT=3306
MOODLE_DBNAME=moodle
MOODLE_DBUSER=CAMBIAR_USUARIO_MYSQL
MOODLE_DBPASS=CAMBIAR_PASSWORD_MYSQL
MOODLE_DB_PREFIX=mdl_
MOODLE_WS_BASE=CAMBIAR_URL_WS_MOODLE
MOODLE_WS_TOKEN=CAMBIAR_TOKEN_MOODLE
KENTH_COURSE_ID_SECRET=CAMBIAR_SECRET_GENERADO_CON_OPENSSL

# Solo para pruebas/desarrollo si Moodle no esta disponible.
# No usar como persistencia operativa de produccion.
SQLITE_DB_PATH=./bd_chat/chats.db
# TESISAI_FORCE_SQLITE=1
