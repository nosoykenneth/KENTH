KENTH_TEXT_MODEL=llama3.2:3b
KENTH_VISION_MODEL=qwen3-vl:4b-instruct
KENTH_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_DIR=./bd_vectorial

# Persistencia operativa Moodle-first.
# Por defecto el backend lee C:\Moodle\server\moodle\config.php.
# Valores reales detectados localmente: MariaDB localhost:3307, db=moodle, user=root.
MOODLE_CONFIG_PATH=C:\Moodle\server\moodle\config.php
MOODLE_DB_PREFIX=mdl_

# Solo para pruebas/desarrollo si Moodle no esta disponible.
# No usar como persistencia operativa de produccion.
SQLITE_DB_PATH=./bd_chat/chats.db
# TESISAI_FORCE_SQLITE=1
