# KENTH ACADEMY — BACKEND CONFIG (api_persistente) — PLANTILLA
# Copia este archivo a `.env` EN EL SERVIDOR (fuera del repositorio) y coloca los
# valores reales. El `.env` real NUNCA se versiona (está en .gitignore) y el
# .htaccess bloquea el acceso directo por URL a .env/.log/.txt/.json/.bak/.sql.

# --- PayPhone (pasarela EC) ---
PAYPHONE_TOKEN=__TU_PAYPHONE_TOKEN__
PAYPHONE_STORE_ID=__TU_PAYPHONE_STORE_ID__

# --- URL pública del frontend (dev: Vite 5173; prod: dominio del gateway) ---
# Usada para responseUrl/cancellationUrl de PayPhone y enlaces de los correos.
FRONTEND_BASE_URL=http://localhost:5173

# --- PayPal ---
PAYPAL_CLIENT_ID=__TU_PAYPAL_CLIENT_ID__
PAYPAL_CLIENT_SECRET=__TU_PAYPAL_CLIENT_SECRET__
PAYPAL_MODE=sandbox

# --- Firma HMAC de course_id (debe COINCIDIR con el backend FastAPI) ---
# tesis_lib.php lee esta variable (getenv) para $KENTH_SECRET.
# Mismo valor que KENTH_COURSE_ID_SECRET en tesis-rag/.env
KENTH_COURSE_ID_SECRET=__CADENA_SECRETA_LARGA_COMPARTIDA__
